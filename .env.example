# Railway: referencia a la base de datos (en el servicio, variable DATABASE_URL = ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://usuario:clave@host:5432/railway
# Clave de la API de Anthropic (se crea en console.anthropic.com)
ANTHROPIC_API_KEY=
# Contraseña larga y propia para administrar y ver el panel
ADMIN_TOKEN=
# Opcional: modelo y dominios web autorizados para el chat
MODEL=claude-sonnet-4-6
ALLOWED_ORIGINS=
